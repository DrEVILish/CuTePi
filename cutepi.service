[Unit]
Description=CuTePi - Cue-based media playback controller
Documentation=https://github.com/DrEVILish/CuTePi
After=network-online.target sound.target
Wants=network-online.target

[Service]
# App installation (binary + templates/ + public/): WorkingDirectory must
# point here because the app reads ./templates and ./public relative to cwd.
WorkingDirectory=/opt/cutepi
Environment=PORT=80

# Runs as the unprivileged "cutepi" system user (deploy/install-service-user.sh
# creates it; its home is /var/lib/cutepi, which also holds WebKit's caches).
# The groups give it the display (DRM master on first open, framebuffer,
# hardware decoders: video), WebKit's GPU render node (render) and ALSA
# (audio). The one capability is binding port 80.
User=cutepi
Group=cutepi
SupplementaryGroups=video render audio
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# The GPU wall runs its threads on SCHED_FIFO 10 (CUTEPI_WALL_RT=nice: nice
# -10 instead) so decoders cannot delay it. Unprivileged, that needs these
# resource limits.
LimitNICE=-10
LimitRTPRIO=10

# User data (config/, ctp.db, media/, thumbnails/, tmp/).
StateDirectory=cutepi
StateDirectoryMode=0750
Environment=WORKING_DIR=/var/lib/cutepi

# The console sharing the HDMI output is switched to graphics mode (no login
# prompt or kernel text on the wall) by these two steps, which run as root
# ("+"): KDSETMODE needs CAP_SYS_TTY_CONFIG and getty keeps the tty
# owner-only. "-": a machine without that console still starts.
ExecStartPre=-+/opt/cutepi/cutepi --console graphics
ExecStart=/opt/cutepi/cutepi
ExecStopPost=-+/opt/cutepi/cutepi --console text

Type=simple
# A crash is restarted (the app closes the DB cleanly on SIGTERM).
Restart=on-failure
RestartSec=3
# Graceful shutdown: main.go handles SIGTERM by closing the DB.
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
