// polkit rules for CuTePi (install to /etc/polkit-1/rules.d/50-cutepi.rules).
//
// cutepi.service runs as the unprivileged "cutepi" user. These are the only
// privileged things its web UI does, each granted to that user alone:
//   - Settings > Restart: systemctl restart cutepi.service
//   - Settings > Network > Wi-Fi hotspot: nmcli connection hotspot / down
//   - Settings > instance name: hostnamectl set-hostname
polkit.addRule(function (action, subject) {
    if (subject.user !== "cutepi") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "cutepi.service" &&
        action.lookup("verb") === "restart") {
        return polkit.Result.YES;
    }
    var allowed = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.settings.modify.own",
        "org.freedesktop.NetworkManager.wifi.share.protected",
        "org.freedesktop.NetworkManager.wifi.share.open",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.hostname1.set-hostname",
        "org.freedesktop.hostname1.set-static-hostname"
    ];
    if (allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
